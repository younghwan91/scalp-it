# 이 파일은 dotfiles 의 cron-install 이 simnode 의 사용자 crontab 에 설치한다.
# 매일 07:50 동기화(pull-all --ci-gate → cron-install)가 origin/main 기준으로 반영한다.
# 크론을 바꾸려면 crontab -e 가 아니라 이 파일을 고쳐 커밋·푸시할 것 — 손으로 고친 건 다음 설치에 덮인다.

# --- scalp-it 분석 배치 (원래 trader crontab 30/32/53/63/64행) ---
# 15:25~15:27 배치 셋(pair_daily_summary·pair_journal·filter_counterfactual)은
# data/pair_*.log 를 읽는데, 이 로그는 trader 의 감지기가 쓴다. 09-11 호스트 분리 뒤로 아무도
# 옮겨주지 않아 여기 사본이 09-10 에 멈춰 있었고, 09-11 일지는 trader 에 섀도 포지션 3건·
# 알림 82건이 있는데도 "진입 0건"으로 나왔다(2026-09-13 확인). 감지기가 15:20 에 스스로
# 끝나므로 15:24 에 trader 정본을 당겨온다. 여기 사본은 trader 파일의 바이트 접두사였음을
# 확인했다 — 덮어써도 잃는 게 없다. --delete 없음(파일 단위 동기화만).
24 15 * * 1-5 rsync -t -e "ssh -o BatchMode=yes -o ConnectTimeout=20" trader-local:git/scalp-it/data/pair_alerts.log trader-local:git/scalp-it/data/pair_positions.log trader-local:git/scalp-it/data/pair_detect.log trader-local:git/scalp-it/data/pair_orders.log /home/young/git/scalp-it/data/ >> /home/young/git/scalp-it/data/pull_trader_logs.cron.log 2>&1 || echo "[$(date '+\%F \%T')] rsync 실패 — 15:25 배치가 낡은 로그를 읽는다" >> /home/young/git/scalp-it/data/pull_trader_logs.cron.log
25 15 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v '^#' ../quant-airflow/.env | xargs) && python3 scripts/pair_daily_summary.py >> /home/young/git/scalp-it/data/pair_daily_summary.cron.log 2>&1
# 만쥬식 매매일지(문서 44 §10-2) — 로그를 사람이 복기할 글로 바꾼다. 집계 직후.
26 15 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg python scripts/pair_journal.py --out data/journal/$(date +\%Y-\%m-\%d).md >> data/pair_journal.cron.log 2>&1
30 18 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg scalp-coverage --min-rate 0.295 0.12 --jsonl data/coverage.jsonl >> data/coverage.log 2>&1

# 뉴스 판단(news_judge) 반응매매 그림자 — 평일 16:05(틱 sanity 16:00 다음, 수집 종료 후).
# 사전등록 docs/research/manju/55. 실주문 없음 — 그림자 리포트만 갱신.
# --from 은 news_judgments 스키마 시작일(2026-09-06) 고정, --to 는 오늘 — 표본을 누적해서 본다(하루치는 100건 판정선에 못 미친다).
5 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg python scripts/news_judge_shadow.py --from 2026-09-06 --to $(date +\%Y-\%m-\%d) >> data/news_judge_shadow.cron.log 2>&1
27 15 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg python scripts/filter_counterfactual.py --from 2026-08-25 --to $(date +\%Y-\%m-\%d) --out data/filter_counterfactual_latest.md >> data/filter_counterfactual.cron.log 2>&1

# 81번 ETF 체결강도 스캘핑 — 평일 16:20(틱 수집 15:40 종료 후). 사전등록 docs/research/manju/81.
# 매일 리포트만 갱신한다(data/etf81_report.md). 판정은 OOS 10거래일·30거래 이후에만 난다.
20 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg python scripts/etf_strength_81.py >> data/etf81.cron.log 2>&1

# 83·84·85 전진 판정 — 평일 16:30/16:40/16:50. 매일은 캐시·거래 건수만(수익 수치 없음),
# 전진 10거래일·30거래가 차면 같은 명령이 start_run(final=True)로 한 번만 판정하고 research/runs/<study> 에 잠근다.
# 전용 venv(~/of80/.rlvenv)·학습 산출물(~/of80/*_model, rl85)은 simnode 에만 있다.
30 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study flow83 >> data/forward_flow83.cron.log 2>&1
40 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study flow84 >> data/forward_flow84.cron.log 2>&1
50 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study rl85 >> data/forward_rl85.cron.log 2>&1
55 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study tiger86 >> data/forward_tiger86.cron.log 2>&1
58 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study rl87 >> data/forward_rl87.cron.log 2>&1
# 86번 실시간 호랑이 그림자용 전일 문턱 — 17:00 계산(16:30 83번 캐시 뒤) → trader 로 보냄. 감지기가 다음 날 09:35 전 문턱으로 쓴다.
0 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/of80/.rlvenv/bin/python -W ignore scripts/tiger_86/prevq.py >> data/tiger86_prevq.cron.log 2>&1 && rsync -t -e "ssh -o BatchMode=yes -o ConnectTimeout=20" data/tiger86_prevq.json trader-local:git/scalp-it/data/ >> data/tiger86_prevq.cron.log 2>&1
# 88번 뉴럴 밴딧 전진(온라인 학습 계속) — 17:05(16:5x 캐시 뒤)
5 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study bandit88 >> data/forward_bandit88.cron.log 2>&1
10 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study bandit89 >> data/forward_bandit89.cron.log 2>&1
15 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study bandit91 >> data/forward_bandit91.cron.log 2>&1
# 92·93·94 RL 전진(고정값 없는 정책들) — 17:20/17:25/17:30
20 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && deploy/research_run.sh /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study rl92 >> data/forward_rl92.cron.log 2>&1
25 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && deploy/research_run.sh /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study rl93 >> data/forward_rl93.cron.log 2>&1
30 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && deploy/research_run.sh /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study rl94 >> data/forward_rl94.cron.log 2>&1
35 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && deploy/research_run.sh /home/young/of80/.rlvenv/bin/python -W ignore scripts/forward_gate.py --study rl96 >> data/forward_rl96.cron.log 2>&1
# 의사결정 패리티(승격 9번) — 17:40. 트레이더의 RL 그림자 기록을 당겨와 배치 재현과 **일치율만** 본다.
# 수익 수치는 전진 최종 평가 때 한 번만 계산한다(OOS 잠금).
40 17 * * 1-5 cd /home/young/git/scalp-it && rsync -t -e "ssh -o BatchMode=yes -o ConnectTimeout=20" trader-local:git/scalp-it/data/rl_shadow_rl92.jsonl data/ >> data/parity_rl92.log 2>&1; deploy/research_run.sh /home/young/of80/.rlvenv/bin/python -W ignore scripts/parity/decision_parity.py --study rl92 --agreement-only >> data/parity_rl92.log 2>&1
# 짝꿍 파라미터 스윕 등 nightly job(research/nightly.toml) — 17:45(17:20~17:30 RL 전진·17:40 패리티 뒤).
# kqc nightly 가 job 마다 격리·timeout 을 건다. 스윕은 krx-quant-core run_sweep(시행 원장 research/runs/).
45 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && deploy/research_run.sh /home/young/.local/bin/uv run kqc nightly . >> data/nightly.cron.log 2>&1

# 분봉 수집 — 2026-09-17 에 수동 루프가 끊겨 1,300종목 → 452종목으로 떨어졌다(09-22 발견).
# 크론으로 고정한다. 15:40 에 trader 감지기가 내려간 뒤 도는 것이 중요하다 —
# 키움 앱키는 1세션 제약이라 장중에 같은 키로 붙으면 매매 쪽 소켓을 밀어낸다.
45 15 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && nice -n 15 .venv/bin/python -m scalp_it.cli_intraday --universe-top 1400 --pages 6 >> data/intraday_minute.cron.log 2>&1
