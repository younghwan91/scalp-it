# 이 파일은 dotfiles 의 cron-install 이 simnode 의 사용자 crontab 에 설치한다.
# 매일 07:50 동기화(pull-all --ci-gate → cron-install)가 origin/main 기준으로 반영한다.
# 크론을 바꾸려면 crontab -e 가 아니라 이 파일을 고쳐 커밋·푸시할 것 — 손으로 고친 건 다음 설치에 덮인다.

# ===== 장중 라이브 — 2026-10-07 trader(N100) 처분으로 이 호스트로 옮겼다 =====
# 아래는 옛 deploy/crontab.trader 를 그대로 옮긴 것이다. 감지기·틱 수집이 쓰는 data/pair_*.log ·
# rl_shadow_rl92.jsonl 과 이 호스트가 만드는 tiger86_prevq.json 이 이제 같은 data/ 에 있으므로
# 두 호스트 사이 rsync 3줄은 없앴다. DB(KR_QUANT_DB)는 그대로 192.168.45.9:5433(자기 자신).

# 틱 수집 헬스체크 — 평일 09:10(조기 경보) + 10:00(안정화 후). 최근 20분 검사, 리포트는 data/tick_health.log (CLI 자체 기록)
10 9 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run scalp-tick-health --minutes 20 >> data/tick_health.cron.log 2>&1
0 10 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run scalp-tick-health --minutes 20 >> data/tick_health.cron.log 2>&1
10 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -E "^(KR_QUANT_DB|KIWOOM_APP_(KEY|SECRET))=" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run scalp-theme-snapshot --sleep 0.3 >> data/theme_snapshot.log 2>&1

# 틱 스캘핑 1차 sanity — 평일 16:00(수집 15:40 종료 후). 그날 ticks 로 트리거 vs 비트리거 forward 수익. 결과 data/tick_sanity_YYYYMMDD.md (사전등록 docs/research/manju/28)
0 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg python scripts/tick_sanity.py --date today >> data/tick_sanity.log 2>&1

# db_guard.sh 는 크론에 넣지 않는다 — 옛 PRIMARY 컨테이너를 되살려 split-brain 을 만든다(64fd022).
# 개장 전 점검(읽기 전용) — 아래 08:55 런처가 요구하는 전제를 미리 확인한다.
#   09-11 레포 이동 이후 9건이 조용히 깨졌고 장이 열린 뒤에야 드러났다. 그 창을
#   개장 전으로 옮기는 자리다. FAIL 이면 종료코드 1 — 로그 끝줄만 봐도 된다.
45 8 * * 1-5 /home/young/git/scalp-it/scripts/preopen_check.sh >> /home/young/git/scalp-it/data/preopen_check.log 2>&1

55 8 * * 1-5 /home/young/git/scalp-it/scripts/pair_detect_daily.sh >> /home/young/git/scalp-it/data/pair_detect_cron.log 2>&1
# 15:40 잔류 정리. 패턴은 첫 글자를 [] 로 감싼다 — 크론은 이 줄 전체를 sh -c 로 돌리므로 맨 패턴이면
# 첫 pkill 이 자기 부모 셸의 명령줄(나머지 패턴이 다 들어 있다)을 맞혀 죽이고, 뒤의 두 pkill 은 안 돈다
# (2026-11-19 재현: rc=143). tests/test_process_patterns.py 가 맨 패턴을 막는다.
40 15 * * 1-5 pkill -f '[s]calp-tick-collect'; pkill -f '[s]calp-pair-detect'; pkill -f '[p]air_detect_daily'

# 만쥬 §2-1 재료 — DART 공시를 매일 최신화한다(유니버스 선정의 세 번째 요건).
# 뉴스 크롤러는 정책상 금지(ToS·저작권, docs/research/manju/17) — 공시가 현실 경로다.
40 8 * * 1-5 cd /home/young/git/scalp-it && export $(grep -E "^DART_API_KEY" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run scalp-dart --start $(date -d "7 days ago" +\%Y\%m\%d) --db data/dart.db >> data/dart_daily.log 2>&1
# 만쥬 §6 돌발 재료 — 장중 DART 를 10분마다 갱신한다. 감지기가 이걸 읽어
# 새 재료 종목을 구독에 추가한다(뉴스 크롤러는 정책상 금지, 공시가 현실 경로).
*/10 9-15 * * 1-5 cd /home/young/git/scalp-it && export $(grep -E "^DART_API_KEY" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run scalp-dart --start $(date +\%Y\%m\%d) --db data/dart.db >> data/dart_intraday.log 2>&1

# 아침 리포트 — 만쥬 체인이 도는지 한 장으로. 로그 다섯 군데를 아침마다 여는 걸 대신한다.
# 지표는 하나다: 방아쇠 구간(상한가 3호가 이내·미잠김)에 틱이 들어온 종목 수.
# 장 마감 뒤 그날치를 쓰고, 다음 날 08:30 에 전 거래일치를 latest.md 로 다시 쓴다.
45 15 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run scalp-morning --date today --out data/morning/$(date +\%Y-\%m-\%d).md >> data/morning_report.log 2>&1
30 8 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run scalp-morning --date yesterday --out data/morning/latest.md >> data/morning_report.log 2>&1

# --- scalp-it 분석 배치 (원래 trader crontab 30/32/53/63/64행) ---
# 15:25~15:27 배치 셋(pair_daily_summary·pair_journal·filter_counterfactual)은
# data/pair_*.log 를 읽는다. 감지기가 15:20 에 스스로 끝난 뒤라 파일이 완성돼 있다.
# (2026-09-13~10-06 엔 trader 에서 15:24 에 rsync 로 당겨왔다 — 같은 호스트가 되며 없앴다.)
25 15 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v '^#' ../quant-airflow/.env | xargs) && python3 scripts/pair_daily_summary.py >> /home/young/git/scalp-it/data/pair_daily_summary.cron.log 2>&1
# 만쥬식 매매일지(문서 44 §10-2) — 로그를 사람이 복기할 글로 바꾼다. 집계 직후.
26 15 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg python scripts/pair_journal.py --out data/journal/$(date +\%Y-\%m-\%d).md >> data/pair_journal.cron.log 2>&1
30 18 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg scalp-coverage --min-rate 0.295 0.12 --jsonl data/coverage.jsonl >> data/coverage.log 2>&1

# 뉴스 판단(news_judge) 반응매매 그림자 — 평일 16:05(틱 sanity 16:00 다음, 수집 종료 후).
# 사전등록 docs/research/manju/55. 실주문 없음 — 그림자 리포트만 갱신.
# --from 은 news_judgments 스키마 시작일(2026-09-06) 고정, --to 는 오늘 — 표본을 누적해서 본다(하루치는 100건 판정선에 못 미친다).
5 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg python scripts/news_judge_shadow.py --from 2026-09-06 --to $(date +\%Y-\%m-\%d) >> data/news_judge_shadow.cron.log 2>&1
27 15 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg python scripts/filter_counterfactual.py --from 2026-08-25 --to $(date +\%Y-\%m-\%d) --out data/filter_counterfactual_latest.md >> data/filter_counterfactual.cron.log 2>&1

# 81번 ETF 체결강도 스캘핑 — 평일 16:20(틱 수집 15:40 종료 후). 사전등록 docs/research/manju/81.
# 매일 리포트만 갱신한다(data/etf81_report.md). 판정은 OOS 10거래일·30거래 이후에만 난다.
20 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/.local/bin/uv run --extra pg python scripts/etf_strength_81.py >> data/etf81.cron.log 2>&1

# 전진 판정 크론 정리(2026-10-08, 사용자 "더 이상 의미 없는 크론은 지워") — 12줄을 뺐다:
#   · 최종 판정이 잠긴 8개(flow83·flow84·rl85·tiger86·rl87·bandit88·bandit89·rl92, research/runs/<study>/FINAL.lock
#     2026-10-01) — 매일 "이미 최종 판정됨, 건너뜀" 만 찍고 끝났다(캐시 빌드 전에 빠져나가 다른 잡에 영향 없음).
#   · rl92 의사결정 패리티(17:40) — 감지기 그림자 기록이 한 줄도 없어 매일 "기록 없음" 이었다.
#   · rl93·rl94(학습이 22M 에서 끊겨 prep.pkl 없음)·rl96(모델 미학습) — 3주째 "대기" 만 찍었다.
#   재학습하면 같은 명령(`scripts/forward_gate.py --study <id>`)을 이 자리에 되살린다(git 이력에 원본 줄).
# bandit91 도 2026-10-12 17:15 최종 판정 기각(FINAL.lock, 7게이트 중 6탈락) → 17:15 줄을 뺐다. 남은 전진 없음.
# 결과 조회는 scripts/forward_verdicts.py.
# 전용 venv(~/of80/.rlvenv)·학습 산출물(~/of80/*)은 simnode 에만 있다.
# 86번 실시간 호랑이 그림자용 전일 문턱 — 17:00 계산(83번 캐시가 없으면 스스로 짓는다). 감지기가 다음 날 09:35 전 문턱으로 같은 data/ 에서 읽는다.
0 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && /home/young/of80/.rlvenv/bin/python -W ignore scripts/tiger_86/prevq.py >> data/tiger86_prevq.cron.log 2>&1
# 짝꿍 파라미터 스윕 등 nightly job(research/nightly.toml) — 17:45(17:00 호랑이 문턱 뒤).
# kqc nightly 가 job 마다 격리·timeout 을 건다. 스윕은 krx-quant-core run_sweep(시행 원장 research/runs/).
45 17 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && deploy/research_run.sh /home/young/.local/bin/uv run kqc nightly . >> data/nightly.cron.log 2>&1

# 분봉 수집 — 2026-09-17 에 수동 루프가 끊겨 1,300종목 → 452종목으로 떨어졌다(09-22 발견).
# 크론으로 고정한다. 15:40 에 감지기가 내려간 뒤 도는 것이 중요하다 —
# 키움 앱키는 1세션 제약이라 장중에 같은 키로 붙으면 매매 쪽 소켓을 밀어낸다.
45 15 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && nice -n 15 .venv/bin/python -m scalp_it.cli_intraday --universe-top 1400 --pages 6 >> data/intraday_minute.cron.log 2>&1

# 수집 건강 점검 — 하루 분커버를 재고 문턱(90%) 아래면 research/bad_days.json 에 자동 등록한다.
# 09-28~10-02 의 커버리지 붕괴(37~52%)를 12일 뒤에 알았다. 사람이 안 보면 아무도 안 본다.
# 16:10 — 15:40 틱 수집이 끝난 뒤 돈다.
10 16 * * 1-5 cd /home/young/git/scalp-it && export $(grep -v "^#" ../quant-airflow/.env | xargs) && nice -n 15 /home/young/of80/.rlvenv/bin/python -W ignore scripts/collect_health.py $(date +\%Y-\%m-\%d) >> data/collect_health.cron.log 2>&1
